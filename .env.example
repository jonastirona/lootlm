HOST=127.0.0.1
PORT=3131
LOOTLM_DATA_DIR=.lootlm
# Optional fixed login code. Otherwise generated and saved in .lootlm/access-code.
# LOOTLM_ACCESS_CODE=replace-with-long-random-secret
LOOTLM_TESTERS=demo@lootlm.local
LOOTLM_ADMINS=demo@lootlm.local
LOOTLM_PROVIDER=demo
# Live calls require all three settings and an explicitly reviewed model pool.
# LOOTLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LOOTLM_LIVE_ENABLED=true
LOOTLM_DAILY_USD=5
LOOTLM_MAX_OUTPUT=1024
LOOTLM_MAX_INPUT_BYTES=24000
# For remote hosting: HTTPS reverse proxy, exact browser origin, and secure cookie.
# LOOTLM_ORIGIN=https://your-private-host.example
# LOOTLM_SECURE_COOKIE=true
